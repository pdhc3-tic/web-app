# Copie este arquivo para .env e preencha os valores
# Obrigatório. Gere uma nova chave com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_pass
DB_HOST=db
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Storage de arquivos
STORAGE_BACKEND=local
MEDIA_URL=/media/
MEDIA_ROOT=media
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pdhc-iii
R2_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.pdhc-iii.org

REDIS_HOST=redis
REDIS_PORT=6379

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_BACKUP_COUNT=14
SECURITY_LOG_LEVEL=INFO
SECURITY_LOG_BACKUP_COUNT=90
AUDIT_EVENT_LOG_LEVEL=INFO
AUDIT_LOG_BACKUP_COUNT=90
ERROR_LOG_BACKUP_COUNT=30
