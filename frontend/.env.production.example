# Copie este arquivo para .env.local na máquina de produção.
# Gere AUTH_SECRET com: openssl rand -base64 32
AUTH_SECRET=
# Necessário quando o Next.js roda atrás do proxy reverso (nginx).
AUTH_TRUST_HOST=true
# Em produção o nginx faz proxy de /api/ para o backend.
# Deixe vazio para usar URLs relativas (mesma origem do frontend).
NEXT_PUBLIC_API_URL=
# URL acessível pelo SERVIDOR do Next.js (Server-side).
# Como o container do Next está dentro da rede Docker, ele usa o nome do serviço 'backend'.
API_INTERNAL_URL=http://backend:8000
